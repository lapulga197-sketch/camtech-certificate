# Neon (or any Postgres) connection string — the pooled one is fine
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Any long random string (e.g. 40+ random characters)
AUTH_SECRET=change-me-to-a-long-random-string

# The first admin — created automatically on first use
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_NAME=Admin

# Public address of the site (used inside the verification QR codes), e.g. https://my-studio.vercel.app
NEXTAUTH_URL=

# --- Optional: e-mail password recovery ("ភ្លេចលេខសម្ងាត់") -------------------
# Without these, a forgot-password request is flagged for the admin, who sets a new password.
# Option 1 — Resend (https://resend.com; needs a verified domain to mail anyone)
#   RESEND_API_KEY=re_xxxxxxxx
# Option 2 — Brevo (https://brevo.com; verify one sender address, no domain needed, free 300/day)
#   BREVO_API_KEY=xkeysib-xxxxxxxx
# Sender shown on the e-mail (must be verified at the provider)
#MAIL_FROM="Certificate Studio <no-reply@example.com>"

# Optional: max DB connections per server instance (default 5). Keep low on Neon free tier.
#DB_POOL_MAX=5
